# Image from GitHub Container Registry. Pin @sha256:... for controlled updates.
MAVI_IMAGE=ghcr.io/zerox80/mavi-vpn:latest

# Container RAM cap, not a measured minimum requirement. Increase for high load.
# Container swap is disabled by setting memswap_limit to the same value.
MAVI_MEMORY_LIMIT=512m

# Required unless using Keycloak. Generate with: openssl rand -hex 32
VPN_AUTH_TOKEN=
RUST_LOG=info

# QUIC/UDP listener. Open this UDP port in the host AND provider firewall.
VPN_BIND_ADDR=0.0.0.0:10443

# Optional HTTP/2 over TLS/TCP. Open its TCP port as well.
# Select HTTP/2 in the client without CR, HTTP/3 framing, or ECH.
# VPN_HTTP2_BIND_ADDR=0.0.0.0:10443

VPN_NETWORK=10.8.0.0/24
VPN_TUN_DEVICE=mavi0
VPN_DNS=1.1.1.1
# Inner TUN MTU: 1280-1360. Outer QUIC payload MTU is derived automatically.
VPN_MTU=1280
VPN_MSS_CLAMPING=true
VPN_ALLOW_CLIENT_TO_CLIENT=false

# IPv4-only by default. Enable host IPv6 forwarding before setting false.
VPN_DISABLE_IPV6=true
VPN_NETWORK_V6=fd00::/64
VPN_IPV6_WAIT=30
# VPN_DNS_V6=2606:4700:4700::1111

# QUIC censorship resistance; enable the matching client setting.
VPN_CENSORSHIP_RESISTANT=false
# VPN_ECH_PUBLIC_NAME=cloudflare-ech.com

# Optional EXISTING Keycloak server; this stack does not start Keycloak/Postgres.
VPN_KEYCLOAK_ENABLED=false
# VPN_KEYCLOAK_URL=https://auth.example.com
# VPN_KEYCLOAK_REALM=mavi-vpn
# VPN_KEYCLOAK_CLIENT_ID=mavi-client
# VPN_KEYCLOAK_REQUIRED_ROLE=vpn-user
# VPN_KEYCLOAK_REQUIRED_SCOPE=vpn:connect
