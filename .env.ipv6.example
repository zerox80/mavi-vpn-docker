# Ready-to-copy IPv4 + IPv6 configuration for a NEW installation:
#   cp .env.ipv6.example .env
#   chmod 600 .env
#   openssl rand -hex 32
#   nano .env
# Paste the generated token into VPN_AUTH_TOKEN below. Keep the other values
# for a standard setup. Existing installations should keep their current token.
#
# Before starting, complete README.md -> Enabling IPv6 on the Linux HOST:
# - Public IPv4 and IPv6 connectivity through the same WAN interface.
# - net.ipv4.ip_forward=1 and net.ipv6.conf.all.forwarding=1.
# - Set net.ipv6.conf.<WAN-interface>.accept_ra=2 BEFORE IPv6 forwarding on
#   networks using router advertisements; persist these settings on the host.
# - net.ipv6.bindv6only=0 so the [::] listener also accepts IPv4 connections.
# - Allow 10443/UDP in the host AND provider firewalls for IPv4 and IPv6.
#   Allow essential ICMPv6 for IPv6 routing and path MTU discovery.
# The .env file configures the VPN; it cannot enable host forwarding itself.

MAVI_IMAGE=ghcr.io/zerox80/mavi-vpn:latest
# RAM cap; increase for high load. Container swap is disabled.
MAVI_MEMORY_LIMIT=512m

# Required unless Keycloak is enabled. Generate with: openssl rand -hex 32
# Leaving this empty stops startup before certificates are created in ./data.
VPN_AUTH_TOKEN=
RUST_LOG=info

# QUIC/UDP on all IPv6 addresses, plus IPv4 when net.ipv6.bindv6only=0.
# Keep the brackets. No public server IP needs to be entered here.
VPN_BIND_ADDR=[::]:10443

# Optional HTTP/2 over TLS/TCP: uncomment and also allow 10443/TCP.
# Select HTTP/2 in the client without CR, HTTP/3 framing, or ECH.
# VPN_HTTP2_BIND_ADDR=[::]:10443

VPN_NETWORK=10.8.0.0/24
VPN_TUN_DEVICE=mavi0
VPN_DNS=1.1.1.1
# Inner TUN MTU: 1280-1360. Outer QUIC payload MTU is derived automatically.
VPN_MTU=1280
VPN_MSS_CLAMPING=true
VPN_ALLOW_CLIENT_TO_CLIENT=false

# false enables IPv6 addresses and internet access for VPN clients.
VPN_DISABLE_IPV6=false
# Internal client subnet used with NAT66. Keep this value; do not put your
# VPS's public IPv6 address or provider-assigned prefix here.
VPN_NETWORK_V6=fd00::/64
# Seconds to wait for a WAN IPv6 address before falling back to IPv4-only.
# Increase to 60 if your provider assigns the address slowly at boot.
VPN_IPV6_WAIT=30
# IPv6 DNS sent to clients while the IPv6 tunnel is active.
VPN_DNS_V6=2606:4700:4700::1111

# QUIC censorship resistance; enable the matching client setting.
VPN_CENSORSHIP_RESISTANT=false
# VPN_ECH_PUBLIC_NAME=cloudflare-ech.com

# Optional EXISTING Keycloak server; this stack does not start Keycloak/Postgres.
VPN_KEYCLOAK_ENABLED=false
# VPN_KEYCLOAK_URL=https://auth.example.com
# VPN_KEYCLOAK_REALM=mavi-vpn
# VPN_KEYCLOAK_CLIENT_ID=mavi-client
# VPN_KEYCLOAK_REQUIRED_ROLE=vpn-user
# VPN_KEYCLOAK_REQUIRED_SCOPE=vpn:connect
